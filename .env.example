# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://aistudio.google.com/apps/33d27ea3-6b8d-4963-a6b2-13f0c2bc9aba?showPreview=true&showAssistant=true"

# OPENAI_API_KEY: Required to access OpenAI inference endpoint.
# Get free or paid tokens from OpenAI Settings -> Developer settings -> Personal access tokens.
# Must have models:read / write permissions.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# TINKER_API_KEY: Required for Tinker thinkingmachines API calls.
TINKER_API_KEY="YOUR_TINKER_API_KEY"

